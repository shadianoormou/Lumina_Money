<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="LuminaMoney.App.Controls.PremiumTabBar"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
 <Border x:Name="BarShell" Padding="7,6" Margin="8,2,8,3" HeightRequest="66" BackgroundColor="#0E1623" Stroke="#27374F" StrokeThickness="1" StrokeShape="RoundRectangle 20">
  <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="3">
   <Border x:Name="HomeItem" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="4,4"><Border.GestureRecognizers><TapGestureRecognizer Tapped="HomeTapped"/></Border.GestureRecognizers><VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center"><Image x:Name="HomeIcon" Source="nav_home.svg" WidthRequest="19" HeightRequest="19"/><Label x:Name="HomeLabel" Text="Home" FontSize="10" CharacterSpacing=".1"/></VerticalStackLayout></Border>
   <Border x:Name="BudgetItem" Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="4,4"><Border.GestureRecognizers><TapGestureRecognizer Tapped="BudgetTapped"/></Border.GestureRecognizers><VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center"><Image x:Name="BudgetIcon" Source="nav_budget.svg" WidthRequest="19" HeightRequest="19"/><Label x:Name="BudgetLabel" Text="Budget" FontSize="10" CharacterSpacing=".1"/></VerticalStackLayout></Border>
   <Border x:Name="ActivityItem" Grid.Column="2" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="4,4"><Border.GestureRecognizers><TapGestureRecognizer Tapped="ActivityTapped"/></Border.GestureRecognizers><VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center"><Image x:Name="ActivityIcon" Source="nav_activity.svg" WidthRequest="19" HeightRequest="19"/><Label x:Name="ActivityLabel" Text="Activity" FontSize="10" CharacterSpacing=".1"/></VerticalStackLayout></Border>
   <Border x:Name="PlanItem" Grid.Column="3" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="4,4"><Border.GestureRecognizers><TapGestureRecognizer Tapped="PlanTapped"/></Border.GestureRecognizers><VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center"><Image x:Name="PlanIcon" Source="nav_plan.svg" WidthRequest="19" HeightRequest="19"/><Label x:Name="PlanLabel" Text="Plan" FontSize="10" CharacterSpacing=".1"/></VerticalStackLayout></Border>
   <Border x:Name="AccountsItem" Grid.Column="4" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="4,4"><Border.GestureRecognizers><TapGestureRecognizer Tapped="AccountsTapped"/></Border.GestureRecognizers><VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center"><Image x:Name="AccountsIcon" Source="nav_accounts.svg" WidthRequest="19" HeightRequest="19"/><Label x:Name="AccountsLabel" Text="Accounts" FontSize="10" CharacterSpacing=".1"/></VerticalStackLayout></Border>
  </Grid>
 </Border>
</ContentView>
