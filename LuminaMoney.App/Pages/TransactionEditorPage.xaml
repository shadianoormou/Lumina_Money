<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="LuminaMoney.App.Pages.TransactionEditorPage" x:Name="EditorPage" Title="{Binding TransactionEditorTitle}"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:LuminaMoney.App.ViewModels" x:DataType="vm:AppViewModel" Shell.NavBarIsVisible="True" Shell.TabBarIsVisible="False" Shell.NavBarHasShadow="False" Shell.BackgroundColor="#080C14" Shell.ForegroundColor="#EAF1FB" Shell.TitleColor="#EAF1FB">
 <ScrollView><VerticalStackLayout x:Name="MotionRoot" Padding="20,14,20,32" Spacing="17">
  <VerticalStackLayout Spacing="3"><Label Text="MONEY ACTIVITY" Style="{StaticResource Eyebrow}"/><Label Text="{Binding TransactionEditorTitle}" Style="{StaticResource H1}"/><Label Text="Changes update budgets, reports and cash flow instantly." Style="{StaticResource Body}"/></VerticalStackLayout>
  <Border Style="{StaticResource SurfaceCard}" Padding="8"><Grid ColumnDefinitions="*,*,*" ColumnSpacing="7"><Button Text="Expense" Clicked="ExpenseClicked" x:Name="ExpenseButton" Style="{StaticResource GreenButton}"/><Button Grid.Column="1" Text="Income" Clicked="IncomeClicked" x:Name="IncomeButton" Style="{StaticResource SecondaryButton}"/><Button Grid.Column="2" Text="Transfer" Clicked="TransferClicked" x:Name="TransferButton" Style="{StaticResource SecondaryButton}"/></Grid></Border>
  <Border Style="{StaticResource HeroCard}" Padding="20"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="13"><Label Text="£" TextColor="White" FontSize="36" FontAttributes="Bold" VerticalOptions="Center"/><Entry Grid.Column="1" Text="{Binding AmountText}" Placeholder="0.00" PlaceholderColor="#BDD2F5" Keyboard="Numeric" TextColor="White" FontSize="38" FontAttributes="Bold"/></Grid></Border>
  <Border Style="{StaticResource SurfaceCard}"><VerticalStackLayout Spacing="15">
   <VerticalStackLayout Spacing="6" IsVisible="{Binding IsTransfer,Converter={StaticResource InverseBoolConverter}}"><Label Text="PAYEE" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Entry Text="{Binding Payee}" Placeholder="Who was this with?"/></Border></VerticalStackLayout>
   <Border IsVisible="{Binding IsTransfer}" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="13"><Label Text="Lumina will name this transfer from the destination account. It moves money without changing income, spending or net worth." Style="{StaticResource Body}"/></Border>
   <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><VerticalStackLayout Spacing="6"><Label Text="FROM ACCOUNT" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Picker ItemsSource="{Binding Accounts}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedAccount}" SemanticProperties.Description="Source account"/></Border></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6" IsVisible="{Binding ShowSingleCategory}"><Label Text="CATEGORY" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Picker ItemsSource="{Binding BudgetCategories}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedCategory}"/></Border></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6" IsVisible="{Binding IsTransfer}"><Label Text="TO ACCOUNT" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Picker ItemsSource="{Binding Accounts}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedTransferAccount}" SemanticProperties.Description="Destination account"/></Border></VerticalStackLayout></Grid>
   <Border IsVisible="{Binding CanSplitTransaction}" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 17" Padding="13"><VerticalStackLayout Spacing="10"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="SPLIT EXPENSE" Style="{StaticResource Eyebrow}"/><Label Text="Divide this total across envelopes" Style="{StaticResource Muted}"/></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding IsSplitTransaction}" OnColor="{StaticResource PrimaryBlue}" SemanticProperties.Description="Split expense across categories"/></Grid><VerticalStackLayout IsVisible="{Binding IsSplitTransaction}" BindableLayout.ItemsSource="{Binding TransactionSplits}" Spacing="8"><BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:TransactionSplitEditorItem"><Grid ColumnDefinitions="*,105,42" ColumnSpacing="7"><Border Style="{StaticResource InputCard}" Padding="8,5"><Picker ItemsSource="{Binding Source={x:Reference EditorPage},Path=BindingContext.BudgetCategories}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding Category}" Title="Category"/></Border><Border Grid.Column="1" Style="{StaticResource InputCard}" Padding="8,5"><Entry Text="{Binding AmountText}" Placeholder="0.00" Keyboard="Numeric"/></Border><Button Grid.Column="2" Text="×" Command="{Binding Source={x:Reference EditorPage},Path=BindingContext.RemoveTransactionSplitCommand}" CommandParameter="{Binding .}" Style="{StaticResource TextButton}" SemanticProperties.Description="Remove split"/></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout><Grid IsVisible="{Binding IsSplitTransaction}" ColumnDefinitions="*,Auto"><Label Text="{Binding SplitRemaining}" TextColor="{StaticResource DeepBlue}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/><Button Grid.Column="1" Text="＋ category" Command="{Binding AddTransactionSplitCommand}" Style="{StaticResource TextButton}"/></Grid></VerticalStackLayout></Border>
   <VerticalStackLayout Spacing="6"><Label Text="NOTE" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Entry Text="{Binding TransactionNote}" Placeholder="Optional context, reference or memo"/></Border></VerticalStackLayout>
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><VerticalStackLayout Spacing="6"><Label Text="DATE" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><DatePicker Date="{Binding TransactionDate}" Format="dd MMM yyyy"/></Border></VerticalStackLayout><Border Grid.Column="1" Style="{StaticResource InputCard}" Padding="14" VerticalOptions="End"><VerticalStackLayout><Label Text="CLEARED" Style="{StaticResource Eyebrow}"/><Switch IsToggled="{Binding IsCleared}" OnColor="{StaticResource PrimaryGreen}"/></VerticalStackLayout></Border></Grid>
  </VerticalStackLayout></Border>
  <Label Text="{Binding FormError}" TextColor="{StaticResource Danger}" FontSize="12"/>
  <Button Text="Save transaction" Command="{Binding SaveTransactionCommand}" Style="{StaticResource GreenButton}"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>
