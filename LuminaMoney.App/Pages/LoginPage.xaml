<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="LuminaMoney.App.Pages.LoginPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:LuminaMoney.App.ViewModels" x:DataType="vm:AuthViewModel" Background="{StaticResource AppBackdrop}">
 <Grid RowDefinitions="*,Auto">
  <ScrollView><VerticalStackLayout x:Name="MotionRoot" Padding="23,20,23,24" Spacing="22">
   <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11"><Border WidthRequest="40" HeightRequest="40" BackgroundColor="#172943" Stroke="#293952" StrokeThickness="1" StrokeShape="RoundRectangle 14"><Label Text="L" TextColor="{StaticResource DeepGreen}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"><Label Text="LUMINA MONEY" FontSize="10" CharacterSpacing="2" FontAttributes="Bold" TextColor="{StaticResource DeepGreen}"/><Label Text="Private finance, clearly." FontSize="12" TextColor="{StaticResource InkSoft}"/></VerticalStackLayout></Grid>
   <VerticalStackLayout Spacing="8"><Label Text="A MORE CONSIDERED WAY TO MANAGE MONEY" FontSize="9" CharacterSpacing="1.3" FontAttributes="Bold" TextColor="{StaticResource DeepGreen}"/><Label Text="A calmer relationship&#10;with money." FontFamily="OpenSansSemibold" FontSize="30" LineHeight="1.08" TextColor="{StaticResource Ink}"/><Label Text="Bring your accounts, spending plan and goals into one clear view." FontSize="14" LineHeight="1.28" TextColor="{StaticResource InkSoft}"/><Border Style="{StaticResource Pill}" BackgroundColor="#14243A" HorizontalOptions="Start" Margin="0,3,0,0"><HorizontalStackLayout Spacing="6"><Label Text="●" TextColor="{StaticResource DeepGreen}" FontSize="7" VerticalOptions="Center"/><Label Text="PRIVATE BY DESIGN" TextColor="{StaticResource DeepGreen}" FontSize="9" CharacterSpacing=".9" FontAttributes="Bold"/></HorizontalStackLayout></Border></VerticalStackLayout>
   <Border Style="{StaticResource AuthFormCard}" VerticalOptions="Start"><VerticalStackLayout Spacing="13" VerticalOptions="Start">
    <Grid ColumnDefinitions="*,Auto"><Label Text="{Binding ActionText}" Style="{StaticResource H2}"/><Border Grid.Column="1" Style="{StaticResource Pill}" BackgroundColor="{StaticResource SoftGreen}"><Label Text="SECURE" TextColor="{StaticResource DeepGreen}" FontSize="9" FontAttributes="Bold"/></Border></Grid>
    <VerticalStackLayout IsVisible="{Binding IsRegistering}" Spacing="5"><Label Text="YOUR NAME" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}" Padding="13,2"><Entry Text="{Binding DisplayName}" Placeholder="How should we greet you?" ReturnType="Next" HeightRequest="48" FontSize="14" SemanticProperties.Description="Your display name"/></Border></VerticalStackLayout>
    <VerticalStackLayout Spacing="5"><Label Text="EMAIL ADDRESS" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}" Padding="13,2"><Entry x:Name="EmailEntry" Text="{Binding Email}" Placeholder="you@example.com" Keyboard="Email" ReturnType="Next" HeightRequest="48" FontSize="14" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" SemanticProperties.Description="Email address"/></Border></VerticalStackLayout>
    <VerticalStackLayout Spacing="5" IsVisible="{Binding ShowCodeField}"><Label Text="SIX-DIGIT CODE" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}" Padding="13,2"><Entry x:Name="CodeEntry" Text="{Binding ResetCode}" Placeholder="000000" Keyboard="Numeric" MaxLength="6" ReturnType="Next" HeightRequest="48" FontSize="14" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" SemanticProperties.Description="Verification or password reset code"/></Border></VerticalStackLayout>
    <VerticalStackLayout Spacing="5" IsVisible="{Binding ShowPasswordField}"><Label Text="{Binding PasswordLabel}" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}" Padding="13,2"><Entry x:Name="PasswordEntry" Text="{Binding Password}" Placeholder="Minimum 10 characters" IsPassword="True" ReturnType="Go" HeightRequest="48" FontSize="14" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" SemanticProperties.Description="Password"/></Border></VerticalStackLayout>
    <Label Text="{Binding Notice}" IsVisible="{Binding Notice, Converter={StaticResource HasTextConverter}}" TextColor="{StaticResource DeepGreen}" FontSize="12"/>
    <Label Text="{Binding Error}" IsVisible="{Binding Error, Converter={StaticResource HasTextConverter}}" TextColor="{StaticResource Danger}" FontSize="12"/>
    <Button Text="{Binding ActionText}" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsBusy,Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource GreenButton}" BackgroundColor="#3479E8" HeightRequest="50" CornerRadius="13" FontSize="14"/>
    <Button Text="Forgot password?" Command="{Binding ForgotPasswordCommand}" IsVisible="{Binding ShowForgotPassword}" Style="{StaticResource TextButton}" HeightRequest="34" MinimumHeightRequest="32" Padding="0"/>
    <Button Text="Resend verification code" Command="{Binding ResendVerificationCommand}" IsVisible="{Binding ShowResendVerification}" Style="{StaticResource TextButton}" HeightRequest="34" MinimumHeightRequest="32" Padding="0"/>
    <Button Text="Back to sign in" Command="{Binding BackToSignInCommand}" IsVisible="{Binding ShowBackToSignIn}" Style="{StaticResource TextButton}" HeightRequest="34" MinimumHeightRequest="32" Padding="0"/>
    <Button Text="{Binding SwitchText}" Command="{Binding SwitchModeCommand}" IsVisible="{Binding ShowModeSwitch}" Style="{StaticResource TextButton}" HeightRequest="34" MinimumHeightRequest="32" Padding="0"/>
   </VerticalStackLayout></Border>
  </VerticalStackLayout></ScrollView>
  <Button Grid.Row="1" Text="Continue offline on this device" Command="{Binding ContinueOfflineCommand}" Margin="23,2,23,14" HeightRequest="48" BackgroundColor="Transparent" TextColor="{StaticResource DeepGreen}" FontSize="12" FontAttributes="Bold"/>
 </Grid>
</ContentPage>
