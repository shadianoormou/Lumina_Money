<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="LuminaMoney.App.Pages.BudgetMovePage" Title="Move money"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:LuminaMoney.App.ViewModels" x:DataType="vm:AppViewModel" Shell.NavBarIsVisible="True" Shell.TabBarIsVisible="False" Shell.BackgroundColor="#080C14" Shell.ForegroundColor="#EAF1FB" Shell.TitleColor="#EAF1FB">
 <ScrollView><VerticalStackLayout x:Name="MotionRoot" Padding="20,14,20,32" Spacing="18">
  <VerticalStackLayout><Label Text="REALLOCATION" Style="{StaticResource Eyebrow}"/><Label Text="Adapt without breaking the plan" Style="{StaticResource H1}"/><Label Text="Move assigned money between envelopes. Your total budget stays unchanged." Style="{StaticResource Body}"/></VerticalStackLayout>
  <Border Style="{StaticResource HeroCard}"><VerticalStackLayout Spacing="6"><Label Text="AVAILABLE FROM SOURCE" Style="{StaticResource HeroEyebrow}"/><Label Text="{Binding MoveAvailableText}" TextColor="White" FontSize="25" FontAttributes="Bold"/><Label Text="Spent money cannot be moved." TextColor="#C6DAFA" FontSize="12"/></VerticalStackLayout></Border>
  <Border Style="{StaticResource SurfaceCard}"><VerticalStackLayout Spacing="16">
   <VerticalStackLayout Spacing="6"><Label Text="FROM ENVELOPE" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Picker ItemsSource="{Binding BudgetCategories}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding MoveFromCategory}"/></Border></VerticalStackLayout>
   <Label Text="↓" TextColor="{StaticResource PrimaryGreen}" FontSize="26" HorizontalOptions="Center"/>
   <VerticalStackLayout Spacing="6"><Label Text="TO ENVELOPE" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Picker ItemsSource="{Binding BudgetCategories}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding MoveToCategory}"/></Border></VerticalStackLayout>
   <VerticalStackLayout Spacing="6"><Label Text="AMOUNT TO MOVE" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Grid ColumnDefinitions="Auto,*"><Label Text="£" TextColor="{StaticResource DeepGreen}" FontSize="25" FontAttributes="Bold" VerticalOptions="Center"/><Entry Grid.Column="1" Text="{Binding MoveAmountText}" Placeholder="0.00" Keyboard="Numeric" FontSize="25"/></Grid></Border></VerticalStackLayout>
   <Label Text="{Binding FormError}" TextColor="{StaticResource Danger}" FontSize="12"/><Button Text="Move assigned money" Command="{Binding SaveBudgetMoveCommand}" Style="{StaticResource GreenButton}"/>
  </VerticalStackLayout></Border>
 </VerticalStackLayout></ScrollView>
</ContentPage>
