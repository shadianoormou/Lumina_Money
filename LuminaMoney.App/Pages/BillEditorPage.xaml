<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="LuminaMoney.App.Pages.BillEditorPage" Title="Bill or subscription"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:LuminaMoney.App.ViewModels" x:DataType="vm:AppViewModel" Shell.NavBarIsVisible="True" Shell.TabBarIsVisible="False" Shell.BackgroundColor="#080C14" Shell.ForegroundColor="#EAF1FB" Shell.TitleColor="#EAF1FB">
 <ScrollView><VerticalStackLayout x:Name="MotionRoot" Padding="20,14,20,32" Spacing="18">
  <VerticalStackLayout><Label Text="UPCOMING COMMITMENT" Style="{StaticResource Eyebrow}"/><Label Text="Never be surprised" Style="{StaticResource H1}"/><Label Text="Recurring commitments feed your forecast and safe-to-spend number." Style="{StaticResource Body}"/></VerticalStackLayout>
  <Border Style="{StaticResource HeroCard}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="15"><Border WidthRequest="54" HeightRequest="54" BackgroundColor="#30FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 18"><Label Text="↻" TextColor="White" FontSize="25" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="RECURRING PAYMENT" Style="{StaticResource HeroEyebrow}"/><Label Text="Cash-flow aware by design" TextColor="White" FontSize="20" FontAttributes="Bold"/></VerticalStackLayout></Grid></Border>
  <Border Style="{StaticResource SurfaceCard}"><VerticalStackLayout Spacing="15">
   <VerticalStackLayout Spacing="6"><Label Text="NAME" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Entry Text="{Binding BillName}" Placeholder="e.g. Broadband"/></Border></VerticalStackLayout>
   <VerticalStackLayout Spacing="6"><Label Text="AMOUNT" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Grid ColumnDefinitions="Auto,*"><Label Text="£" VerticalOptions="Center" TextColor="{StaticResource DeepGreen}" FontAttributes="Bold"/><Entry Grid.Column="1" Text="{Binding BillAmountText}" Placeholder="0.00" Keyboard="Numeric"/></Grid></Border></VerticalStackLayout>
   <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><VerticalStackLayout Spacing="6"><Label Text="NEXT DUE" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><DatePicker Date="{Binding BillDueDate}" Format="dd MMM yyyy"/></Border></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6"><Label Text="REPEATS" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Picker ItemsSource="{Binding BillFrequencies}" SelectedItem="{Binding SelectedBillFrequency}"/></Border></VerticalStackLayout></Grid>
   <VerticalStackLayout Spacing="6"><Label Text="BUDGET CATEGORY" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Picker ItemsSource="{Binding BudgetCategories}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedBillCategory}" Title="Optional category"/></Border></VerticalStackLayout>
   <Border Style="{StaticResource InputCard}" Padding="15"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Subscription" Style="{StaticResource ItemTitle}"/><Label Text="Mark services such as streaming or software" Style="{StaticResource Muted}"/></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding IsSubscription}" OnColor="{StaticResource PrimaryGreen}"/></Grid></Border>
   <Label Text="{Binding FormError}" TextColor="{StaticResource Danger}" FontSize="12"/><Button Text="Save commitment" Command="{Binding SaveBillCommand}" Style="{StaticResource GreenButton}"/><Button Text="Delete commitment" Command="{Binding DeleteBillCommand}" IsVisible="{Binding IsEditingBill}" Style="{StaticResource DangerButton}"/>
  </VerticalStackLayout></Border>
 </VerticalStackLayout></ScrollView>
</ContentPage>
