<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="LuminaMoney.App.Pages.TransactionsPage" x:Name="ActivityPage"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:LuminaMoney.App.ViewModels" xmlns:controls="clr-namespace:LuminaMoney.App.Controls" x:DataType="vm:AppViewModel" BackgroundColor="{StaticResource PageBackground}" Shell.TabBarIsVisible="False">
 <Grid RowDefinitions="*,Auto" Shell.TabBarIsVisible="False"><Grid x:Name="MotionRoot" Grid.Row="0" RowDefinitions="Auto,*" Padding="20,14,20,8">
  <VerticalStackLayout Spacing="13">
   <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="MONEY ACTIVITY" Style="{StaticResource Eyebrow}"/><Label Text="Transactions" Style="{StaticResource H1}"/><Label Text="Search, filter, edit or reconcile every move" Style="{StaticResource Muted}"/></VerticalStackLayout><Button Grid.Column="1" Text="＋" Command="{Binding AddTransactionCommand}" Style="{StaticResource GreenButton}" WidthRequest="54" VerticalOptions="Center"/></Grid>
   <Border IsVisible="{Binding HasStatusMessage}" BackgroundColor="{StaticResource SoftGreen}" StrokeThickness="0" StrokeShape="RoundRectangle 13" Padding="12,9"><Label Text="{Binding StatusMessage}" TextColor="{StaticResource DeepGreen}" FontSize="12"/></Border>
   <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
    <Border Style="{StaticResource InteractiveMetricCard}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenIncomeTransactionsCommand}"/></Border.GestureRecognizers><VerticalStackLayout><Label Text="INCOMING" Style="{StaticResource Eyebrow}"/><Label Text="{Binding MonthlyIncome}" Style="{StaticResource H2}" TextColor="{StaticResource PrimaryGreen}"/><Label Text="Tap to isolate" Style="{StaticResource Muted}"/></VerticalStackLayout></Border>
    <Border Grid.Column="1" Style="{StaticResource InteractiveMetricCard}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenExpenseTransactionsCommand}"/></Border.GestureRecognizers><VerticalStackLayout><Label Text="OUTGOING" Style="{StaticResource Eyebrow}"/><Label Text="{Binding MonthlySpent}" Style="{StaticResource H2}" TextColor="{StaticResource PrimaryBlue}"/><Label Text="Tap to isolate" Style="{StaticResource Muted}"/></VerticalStackLayout></Border>
   </Grid>
   <Border Style="{StaticResource InputCard}" Padding="10,0"><SearchBar Placeholder="Search payee or note" Text="{Binding SearchText}"/></Border>
   <CollectionView ItemsSource="{Binding TransactionFilters}" ItemsLayout="HorizontalList" HeightRequest="44"><CollectionView.ItemTemplate><DataTemplate x:DataType="vm:FilterItem"><Border Padding="14,8" Margin="0,0,8,0" BackgroundColor="{Binding Background}" StrokeThickness="0" StrokeShape="RoundRectangle 50"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference ActivityPage},Path=BindingContext.SetTransactionFilterCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers><Label Text="{Binding Name}" TextColor="{Binding TextColor}" FontSize="10" FontAttributes="Bold"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
   <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5"><Label Text="ALL ACTIVITY" Style="{StaticResource Eyebrow}" VerticalOptions="Center"/><Button Grid.Column="1" Text="Import CSV" Command="{Binding ImportCsvCommand}" Style="{StaticResource TextButton}"/><Button Grid.Column="2" Text="Export" Command="{Binding ExportCsvCommand}" Style="{StaticResource TextButton}"/></Grid>
  </VerticalStackLayout>
  <CollectionView Grid.Row="1" ItemsSource="{Binding Transactions}" RemainingItemsThreshold="10" RemainingItemsThresholdReachedCommand="{Binding LoadMoreTransactionsCommand}" Margin="0,10,0,0">
   <CollectionView.EmptyView><VerticalStackLayout Margin="0,50" HorizontalOptions="Center" Spacing="7"><Border WidthRequest="64" HeightRequest="64" BackgroundColor="{StaticResource SoftGreen}" StrokeThickness="0" StrokeShape="RoundRectangle 22"><Label Text="◎" FontSize="30" TextColor="{StaticResource PrimaryGreen}" HorizontalOptions="Center" VerticalOptions="Center"/></Border><Label Text="No matching activity" Style="{StaticResource H3}" HorizontalOptions="Center"/><Label Text="Change the filter or record a transaction." Style="{StaticResource Muted}"/><Button Text="Add transaction" Command="{Binding Source={x:Reference ActivityPage},Path=BindingContext.AddTransactionCommand}" Style="{StaticResource TextButton}"/></VerticalStackLayout></CollectionView.EmptyView>
   <CollectionView.ItemTemplate><DataTemplate x:DataType="vm:TransactionItem"><SwipeView><SwipeView.RightItems><SwipeItems Mode="Execute"><SwipeItem Text="Delete" BackgroundColor="{StaticResource Danger}" Command="{Binding Source={x:Reference ActivityPage},Path=BindingContext.DeleteTransactionCommand}" CommandParameter="{Binding .}"/></SwipeItems></SwipeView.RightItems><Border Style="{StaticResource InteractiveListCard}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference ActivityPage},Path=BindingContext.EditTransactionCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers><Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="11"><Border Style="{StaticResource IconTile}" BackgroundColor="#14243A"><Label Text="↗" TextColor="{Binding Color}" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="{Binding Payee}" Style="{StaticResource ItemTitle}"/><Label Text="{Binding Category}" Style="{StaticResource Muted}"/><Label Text="{Binding Account}" TextColor="{StaticResource InkSoft}" FontSize="10"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2" VerticalOptions="Center"><Label Text="{Binding AmountText}" TextColor="{Binding Color}" FontAttributes="Bold" HorizontalTextAlignment="End"/><Label Text="{Binding DateText}" Style="{StaticResource Muted}" HorizontalTextAlignment="End"/><Label Text="{Binding StateText}" TextColor="{Binding StateColor}" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="End"/></VerticalStackLayout></Grid></Border></SwipeView></DataTemplate></CollectionView.ItemTemplate>
  </CollectionView>
 </Grid><controls:PremiumTabBar Grid.Row="1" ActiveTab="Activity"/></Grid>
</ContentPage>
