<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="LuminaMoney.App.Pages.MembershipPage" Title="Lumina Plus"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:LuminaMoney.App.ViewModels" xmlns:services="clr-namespace:LuminaMoney.App.Services" x:DataType="vm:MembershipViewModel" BackgroundColor="{StaticResource PageBackground}"
 Shell.NavBarIsVisible="True" Shell.TabBarIsVisible="False" Shell.NavBarHasShadow="False">
 <ScrollView><VerticalStackLayout x:Name="MotionRoot" Padding="20,14,20,44" Spacing="18">
  <Border Style="{StaticResource HeroCard}" Padding="24"><VerticalStackLayout Spacing="12"><Border BackgroundColor="#2CFFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 50" Padding="12,7" HorizontalOptions="Start"><Label Text="LUMINA PLUS" TextColor="White" FontSize="10" CharacterSpacing="1.4" FontAttributes="Bold"/></Border><Label Text="Build wealth with&#10;complete clarity." TextColor="White" FontSize="31" FontAttributes="Bold" LineHeight="1.05"/><Label Text="Advanced planning, bank connections and intelligent money guidance in one protected membership." TextColor="#C6DAFA" FontSize="13" LineHeight="1.35"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><VerticalStackLayout><Label Text="CURRENT PLAN" Style="{StaticResource HeroEyebrow}"/><Label Text="{Binding CurrentPlan}" Style="{StaticResource HeroMetric}"/></VerticalStackLayout><ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" Color="White" HorizontalOptions="End"/></Grid></VerticalStackLayout></Border>
  <Border BackgroundColor="{StaticResource SoftBlue}" Stroke="#CBDCFF" StrokeShape="RoundRectangle 18" Padding="15"><Label Text="{Binding Status}" TextColor="{StaticResource DeepBlue}" FontSize="12" LineHeight="1.3"/></Border>
  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
   <Border Style="{StaticResource SurfaceCard}"><VerticalStackLayout Spacing="8"><Label Text="◈" TextColor="{StaticResource PrimaryGreen}" FontSize="23"/><Label Text="Open Banking" Style="{StaticResource H3}"/><Label Text="Consent-based account and transaction connections." Style="{StaticResource Muted}"/></VerticalStackLayout></Border>
   <Border Grid.Column="1" Style="{StaticResource SurfaceCard}"><VerticalStackLayout Spacing="8"><Label Text="↗" TextColor="{StaticResource PrimaryBlue}" FontSize="23"/><Label Text="Smart planning" Style="{StaticResource H3}"/><Label Text="Forecasts, rollover budgets and goal guidance." Style="{StaticResource Muted}"/></VerticalStackLayout></Border>
  </Grid>
  <VerticalStackLayout BindableLayout.ItemsSource="{Binding Products}" Spacing="12" IsVisible="{Binding HasProducts}">
   <BindableLayout.ItemTemplate><DataTemplate x:DataType="services:StoreProduct"><Border Style="{StaticResource SurfaceCard}" Stroke="#B8E8D7" StrokeThickness="2"><Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8"><VerticalStackLayout><Label Text="{Binding Title}" FontSize="19" FontAttributes="Bold"/><Label Text="{Binding Period}" Style="{StaticResource Muted}"/></VerticalStackLayout><Label Grid.Column="1" Text="{Binding Price}" TextColor="{StaticResource DeepGreen}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/><Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" Style="{StaticResource Body}"/><Button Grid.Row="2" Grid.ColumnSpan="2" Text="Choose this plan" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MembershipViewModel}}, Path=BuyCommand}" CommandParameter="{Binding .}" Style="{StaticResource GreenButton}"/></Grid></Border></DataTemplate></BindableLayout.ItemTemplate>
  </VerticalStackLayout>
  <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="Restore purchases" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsConfigured}"/><Button Grid.Column="1" Text="Manage subscription" Command="{Binding ManageCommand}" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsConfigured}"/></Grid>
  <Label Text="Payment is completed by Apple App Store or Google Play. Lumina never receives your card details. Membership access is granted only after server-side purchase verification." Style="{StaticResource Muted}" HorizontalTextAlignment="Center"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>
