<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="LuminaMoney.App.Pages.AccountEditorPage" Title="Account"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:LuminaMoney.App.ViewModels" x:DataType="vm:AppViewModel" BackgroundColor="#080C14" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False">
 <ScrollView><VerticalStackLayout x:Name="MotionRoot" Padding="22,10,22,30" Spacing="15">
  <Grid ColumnDefinitions="42,*" ColumnSpacing="10" VerticalOptions="Center"><Border WidthRequest="38" HeightRequest="38" BackgroundColor="{StaticResource SurfaceRaised}" Stroke="{StaticResource Line}" StrokeThickness="1" StrokeShape="RoundRectangle 13"><Border.GestureRecognizers><TapGestureRecognizer Tapped="BackTapped"/></Border.GestureRecognizers><Label Text="‹" FontSize="27" TextColor="{StaticResource Ink}" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center"><Label Text="ACCOUNT SETUP" FontSize="9" CharacterSpacing="1.4" FontAttributes="Bold" TextColor="{StaticResource DeepGreen}"/><Label Text="New account" FontFamily="OpenSansSemibold" FontSize="17"><Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsEditingAccount}" Value="True"><Setter Property="Text" Value="Edit account"/></DataTrigger></Label.Triggers></Label></VerticalStackLayout></Grid>
  <VerticalStackLayout Spacing="5" Margin="0,5,0,2"><Label Text="Build your complete picture" FontFamily="OpenSansSemibold" FontSize="26" LineHeight="1.08" TextColor="{StaticResource Ink}"/><Label Text="Balances stay available offline and sync securely when connected." FontSize="13" LineHeight="1.25" TextColor="{StaticResource InkSoft}"/></VerticalStackLayout>
  <Border BackgroundColor="#14243A" StrokeThickness="0" StrokeShape="RoundRectangle 13" Padding="12,10"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="9"><Label Text="✓" TextColor="{StaticResource DeepGreen}" FontSize="15" FontAttributes="Bold"/><Label Grid.Column="1" Text="Private by design · Edit balances any time" FontSize="11" TextColor="{StaticResource DeepGreen}" VerticalOptions="Center"/></Grid></Border>
  <Border Style="{StaticResource SurfaceCard}"><VerticalStackLayout Spacing="13">
   <VerticalStackLayout Spacing="6"><Label Text="ACCOUNT NAME" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Entry Text="{Binding AccountName}" Placeholder="e.g. Everyday current account"/></Border></VerticalStackLayout>
   <VerticalStackLayout Spacing="6"><Label Text="ACCOUNT TYPE" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Picker ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding SelectedAccountType}" Title="Select account type"/></Border></VerticalStackLayout>
   <VerticalStackLayout Spacing="6"><Label Text="OPENING BALANCE" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Grid ColumnDefinitions="Auto,*"><Label Text="£" VerticalOptions="Center" TextColor="{StaticResource DeepGreen}" FontAttributes="Bold"/><Entry Grid.Column="1" Text="{Binding OpeningBalanceText}" Placeholder="0.00" Keyboard="Numeric"/></Grid></Border><Label Text="For credit cards or loans, use a negative balance." Style="{StaticResource Muted}"/></VerticalStackLayout>
   <Label Text="{Binding FormError}" IsVisible="{Binding FormError, Converter={StaticResource HasTextConverter}}" TextColor="{StaticResource Danger}" FontSize="12"/>
   <Button Text="Save account" Command="{Binding SaveAccountCommand}" Style="{StaticResource GreenButton}" HeightRequest="50"/>
   <Border IsVisible="{Binding IsEditingAccount}" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="15"><VerticalStackLayout Spacing="10"><Label Text="RECONCILE WITH BANK" Style="{StaticResource Eyebrow}"/><Label Text="{Binding ReconcileCurrentBalance}" Style="{StaticResource H3}"/><Label Text="Enter the closing balance shown by your bank. Lumina will clear matched activity and record any difference as an explicit adjustment." Style="{StaticResource Muted}"/><Border Style="{StaticResource InputCard}"><Grid ColumnDefinitions="Auto,*"><Label Text="£" VerticalOptions="Center" TextColor="{StaticResource DeepBlue}" FontAttributes="Bold"/><Entry Grid.Column="1" Text="{Binding ReconcileBalanceText}" Placeholder="Statement balance" Keyboard="Numeric" SemanticProperties.Description="Bank statement closing balance"/></Grid></Border><Button Text="Reconcile account" Command="{Binding ReconcileAccountCommand}" Style="{StaticResource SecondaryButton}"/></VerticalStackLayout></Border>
   <Button Text="Archive account" Command="{Binding ArchiveAccountCommand}" IsVisible="{Binding IsEditingAccount}" Style="{StaticResource DangerButton}"/>
  </VerticalStackLayout></Border>
 </VerticalStackLayout></ScrollView>
</ContentPage>
