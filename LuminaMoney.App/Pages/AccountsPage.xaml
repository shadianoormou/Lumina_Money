<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="LuminaMoney.App.Pages.AccountsPage" x:Name="AccountsPageView"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:LuminaMoney.App.Controls"
 xmlns:vm="clr-namespace:LuminaMoney.App.ViewModels" x:DataType="vm:AppViewModel" BackgroundColor="{StaticResource PageBackground}" Shell.TabBarIsVisible="False">
 <Grid RowDefinitions="*,Auto" Shell.TabBarIsVisible="False"><ScrollView Grid.Row="0"><VerticalStackLayout x:Name="MotionRoot" Padding="20,14,20,34" Spacing="17">
  <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="ASSETS &amp; LIABILITIES" Style="{StaticResource Eyebrow}"/><Label Text="Accounts" Style="{StaticResource H1}"/><Label Text="A reconciled view of cash, credit and investments" Style="{StaticResource Muted}"/></VerticalStackLayout><Button Grid.Column="1" Text="＋" Command="{Binding AddAccountCommand}" Style="{StaticResource GreenButton}" WidthRequest="54" VerticalOptions="Center"/></Grid>
  <Border IsVisible="{Binding HasStatusMessage}" BackgroundColor="{StaticResource SoftGreen}" StrokeThickness="0" StrokeShape="RoundRectangle 13" Padding="12,9"><Label Text="{Binding StatusMessage}" TextColor="{StaticResource DeepGreen}" FontSize="12"/></Border>
  <Border BackgroundColor="#14243A" Stroke="#293952" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="18"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="7"><Label Text="COMBINED NET WORTH" FontSize="10" CharacterSpacing="1.3" TextColor="#9ABEFF" FontAttributes="Bold"/><Border Grid.Column="1" Padding="9,5" BackgroundColor="#1B2C46" StrokeThickness="0" StrokeShape="RoundRectangle 50"><Label Text="CLEARED BALANCES" TextColor="#A8CBFF" FontSize="9" FontAttributes="Bold"/></Border><Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding NetWorth}" TextColor="#EAF1FB" FontFamily="OpenSansSemibold" FontSize="32" FontAttributes="Bold"/><Label Grid.Row="2" Text="Across active accounts" TextColor="#91A0B6" FontSize="11"/><Label Grid.Row="2" Grid.Column="1" Text="Manage below  ↓" TextColor="#91BCFF" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="End"/></Grid></Border>
  <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Border Style="{StaticResource InteractiveActionCard}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ImportCsvCommand}"/></Border.GestureRecognizers><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Border Style="{StaticResource IconTile}" WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource SoftBlue}"><Label Text="↓" TextColor="{StaticResource DeepBlue}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Import CSV" FontAttributes="Bold"/><Label Text="Bring bank activity" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid></Border><Border Grid.Column="1" Style="{StaticResource InteractiveActionCard}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ExportCsvCommand}"/></Border.GestureRecognizers><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Border Style="{StaticResource IconTile}" WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource SoftGreen}"><Label Text="↑" TextColor="{StaticResource DeepGreen}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Export data" FontAttributes="Bold"/><Label Text="Portable CSV backup" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid></Border></Grid>
  <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Active accounts" Style="{StaticResource H2}"/><Label Text="Tap to edit or archive" Style="{StaticResource Muted}"/></VerticalStackLayout><Border Grid.Column="1" Style="{StaticResource Pill}" BackgroundColor="{StaticResource SoftGreen}" VerticalOptions="Center"><Label Text="OFFLINE FIRST" TextColor="{StaticResource DeepGreen}" FontSize="9" FontAttributes="Bold"/></Border></Grid>
  <VerticalStackLayout BindableLayout.ItemsSource="{Binding AccountCards}"><BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:AccountItem"><Border Style="{StaticResource InteractiveListCard}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference AccountsPageView},Path=BindingContext.EditAccountCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers><Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="12"><Border Style="{StaticResource IconTile}" BackgroundColor="{Binding Color}"><Label Text="{Binding Initials}" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="{Binding Name}" Style="{StaticResource ItemTitle}"/><Label Text="{Binding Type}" Style="{StaticResource Muted}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2" VerticalOptions="Center"><Label Text="{Binding Balance}" Style="{StaticResource H3}" HorizontalTextAlignment="End"/><Label Text="{Binding BalanceLabel}" Style="{StaticResource Eyebrow}" HorizontalTextAlignment="End"/></VerticalStackLayout></Grid></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
  <VerticalStackLayout IsVisible="{Binding HasArchivedAccounts}" Spacing="9"><Label Text="Archived accounts" Style="{StaticResource H2}"/><Label Text="History remains in reports. Tap Restore to reactivate." Style="{StaticResource Muted}"/><VerticalStackLayout BindableLayout.ItemsSource="{Binding ArchivedAccountCards}"><BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:AccountItem"><Border Style="{StaticResource ListCard}" Opacity="0.72"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Name}" Style="{StaticResource ItemTitle}"/><Label Text="{Binding Balance}" Style="{StaticResource Muted}"/></VerticalStackLayout><Button Grid.Column="1" Text="Restore" Command="{Binding Source={x:Reference AccountsPageView},Path=BindingContext.RestoreAccountCommand}" CommandParameter="{Binding .}" Style="{StaticResource TextButton}"/></Grid></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout>
  <Border Style="{StaticResource SurfaceCard}" BackgroundColor="{StaticResource SoftBlue}" Stroke="#2D4C75" StrokeThickness="1"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Label Text="⌁" TextColor="{StaticResource PrimaryBlue}" FontSize="25" VerticalOptions="Center"/><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Keep your accounts current" Style="{StaticResource H3}"/><Label Text="Add balances manually or import transactions from a CSV. Secure bank linking depends on provider availability." Style="{StaticResource Body}"/></VerticalStackLayout></Grid></Border>
 </VerticalStackLayout></ScrollView><controls:PremiumTabBar Grid.Row="1" ActiveTab="Accounts"/></Grid>
</ContentPage>
