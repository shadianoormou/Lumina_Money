<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="LuminaMoney.App.Pages.ReportsPage" x:Name="ReportsPageView" Title="Reports"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:LuminaMoney.App.ViewModels" xmlns:controls="clr-namespace:LuminaMoney.App.Controls" x:DataType="vm:AppViewModel" Shell.NavBarIsVisible="True" Shell.TabBarIsVisible="False" Shell.BackgroundColor="#080C14" Shell.ForegroundColor="#EAF1FB" Shell.TitleColor="#EAF1FB">
 <ScrollView><VerticalStackLayout x:Name="MotionRoot" Padding="20,14,20,34" Spacing="17">
  <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="FINANCIAL INTELLIGENCE" Style="{StaticResource Eyebrow}"/><Label Text="Reports" Style="{StaticResource H1}"/><Label Text="Drill into cash flow and category behaviour" Style="{StaticResource Muted}"/></VerticalStackLayout><Button Grid.Column="1" Text="Export" Command="{Binding ExportCsvCommand}" Style="{StaticResource TextButton}" VerticalOptions="Center"/></Grid>
  <CollectionView ItemsSource="{Binding ReportPeriods}" ItemsLayout="HorizontalList" HeightRequest="44"><CollectionView.ItemTemplate><DataTemplate x:DataType="vm:FilterItem"><Border Padding="17,8" Margin="0,0,8,0" BackgroundColor="{Binding Background}" StrokeThickness="0" StrokeShape="RoundRectangle 50"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference ReportsPageView},Path=BindingContext.SetReportPeriodCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers><Label Text="{Binding Name}" TextColor="{Binding TextColor}" FontSize="10" FontAttributes="Bold"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
  <Border Style="{StaticResource HeroCard}"><Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8"><Label Text="NET CASH FLOW" Style="{StaticResource HeroEyebrow}"/><Border Grid.Column="1" BackgroundColor="#32FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 50" Padding="10,5"><Label Text="LIVE REPORT" TextColor="White" FontSize="9" FontAttributes="Bold"/></Border><Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ReportNet}" Style="{StaticResource HeroAmount}"/><Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*"><VerticalStackLayout><Label Text="INCOME" Style="{StaticResource HeroEyebrow}"/><Label Text="{Binding ReportIncome}" TextColor="White" FontAttributes="Bold"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="EXPENSES" Style="{StaticResource HeroEyebrow}"/><Label Text="{Binding ReportExpenses}" TextColor="White" FontAttributes="Bold"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2"><Label Text="AVERAGE" Style="{StaticResource HeroEyebrow}"/><Label Text="{Binding AverageSpend}" TextColor="White" FontAttributes="Bold"/></VerticalStackLayout></Grid></Grid></Border>
  <Border Style="{StaticResource SurfaceCard}"><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="CASH-FLOW HISTORY" Style="{StaticResource Eyebrow}"/><Label Text="Income minus spending" Style="{StaticResource H2}"/></VerticalStackLayout><Border Grid.Column="1" Style="{StaticResource Pill}" BackgroundColor="{StaticResource SoftGreen}" VerticalOptions="Start"><Label Text="INTERACTIVE PERIOD" TextColor="{StaticResource DeepGreen}" FontSize="9" FontAttributes="Bold"/></Border></Grid><controls:CashFlowChart Values="{Binding ReportCashFlowSeries}"/></VerticalStackLayout></Border>
  <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Spending by category" Style="{StaticResource H2}"/><Label Text="Ranked by total outflow" Style="{StaticResource Muted}"/></VerticalStackLayout><Button Grid.Column="1" Text="Budget  →" Command="{Binding OpenBudgetCommand}" Style="{StaticResource TextButton}"/></Grid>
  <VerticalStackLayout BindableLayout.ItemsSource="{Binding ReportCategories}"><BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:ReportCategoryItem"><Border Style="{StaticResource ListCard}"><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><BoxView WidthRequest="9" HeightRequest="9" Color="{Binding Color}" CornerRadius="5" VerticalOptions="Center"/><Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource ItemTitle}"/><Label Grid.Column="2" Text="{Binding Amount}" FontAttributes="Bold"/></Grid><ProgressBar Progress="{Binding Progress}" ProgressColor="{Binding Color}"/></VerticalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
  <Border Style="{StaticResource SurfaceCard}" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Label Text="i" TextColor="{StaticResource DeepBlue}" FontSize="22" FontAttributes="Bold"/><Label Grid.Column="1" Text="Reports use recorded transactions only. Import bank CSV activity to make trends complete." Style="{StaticResource Body}"/></Grid></Border>
 </VerticalStackLayout></ScrollView>
</ContentPage>
