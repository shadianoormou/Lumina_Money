<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="LuminaMoney.App.Pages.BudgetPage" x:Name="BudgetPageView"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:LuminaMoney.App.ViewModels" xmlns:controls="clr-namespace:LuminaMoney.App.Controls" x:DataType="vm:AppViewModel" BackgroundColor="{StaticResource PageBackground}" Shell.TabBarIsVisible="False">
 <Grid RowDefinitions="*,Auto" Shell.TabBarIsVisible="False"><Grid Grid.Row="0" RowDefinitions="Auto,*" Padding="20,14,20,8">
  <VerticalStackLayout x:Name="MotionRoot" Spacing="14">
   <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="ZERO-BASED PLAN" Style="{StaticResource Eyebrow}"/><Label Text="Budget" Style="{StaticResource H1}"/><Label Text="Assign deliberately, then move money as life changes" Style="{StaticResource Muted}"/></VerticalStackLayout><Button Grid.Column="1" Text="＋" Command="{Binding AddCategoryCommand}" Style="{StaticResource GreenButton}" WidthRequest="54" VerticalOptions="Center"/></Grid>
   <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"><Button Text="‹" Command="{Binding ChangeBudgetMonthCommand}" CommandParameter="previous" Style="{StaticResource TextButton}" FontSize="24"/><Border Grid.Column="1" Style="{StaticResource Pill}" BackgroundColor="#16243A"><Label Text="{Binding CurrentMonth}" TextColor="{StaticResource Ink}" FontAttributes="Bold" HorizontalOptions="Center"/></Border><Button Grid.Column="2" Text="›" Command="{Binding ChangeBudgetMonthCommand}" CommandParameter="next" Style="{StaticResource TextButton}" FontSize="24"/></Grid>
   <Border IsVisible="{Binding HasStatusMessage}" BackgroundColor="{StaticResource SoftGreen}" StrokeThickness="0" StrokeShape="RoundRectangle 13" Padding="12,9"><Label Text="{Binding StatusMessage}" TextColor="{StaticResource DeepGreen}" FontSize="12"/></Border>
   <Border BackgroundColor="#14243A" Stroke="#293952" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="17"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8"><Label Text="READY TO ASSIGN" FontSize="10" CharacterSpacing="1.3" TextColor="#9ABEFF" FontAttributes="Bold"/><Border Grid.Column="1" BackgroundColor="#1B2C46" StrokeThickness="0" StrokeShape="RoundRectangle 50" Padding="10,5"><Label Text="LIVE TOTAL" TextColor="#A8CBFF" FontSize="9" FontAttributes="Bold"/></Border><Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ReadyToAssign}" TextColor="#EAF1FB" FontFamily="OpenSansSemibold" FontSize="32" FontAttributes="Bold"/><Label Grid.Row="2" Grid.ColumnSpan="2" Text="Income less the money assigned this month" TextColor="#91A0B6" FontSize="11"/><HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="9" Margin="0,2,0,0"><Button Text="Assign money" Command="{Binding OpenBudgetAssignCommand}" BackgroundColor="#3479E8" TextColor="White" CornerRadius="11" FontAttributes="Bold" FontSize="11" HeightRequest="40" Padding="14,0"/><Button Text="Move money" Command="{Binding OpenBudgetMoveCommand}" BackgroundColor="#1A2A43" TextColor="#A9C9FF" CornerRadius="11" FontAttributes="Bold" FontSize="11" HeightRequest="40" Padding="14,0"/></HorizontalStackLayout></Grid></Border>
   <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"><Border Style="{StaticResource ActionCard}"><VerticalStackLayout><Label Text="ASSIGNED" Style="{StaticResource Eyebrow}"/><Label Text="{Binding AssignedTotal}" Style="{StaticResource H3}" TextColor="{StaticResource DeepGreen}"/></VerticalStackLayout></Border><Border Grid.Column="1" Style="{StaticResource ActionCard}"><VerticalStackLayout><Label Text="ROLLOVER" Style="{StaticResource Eyebrow}"/><Label Text="{Binding RolloverTotal}" Style="{StaticResource H3}" TextColor="{StaticResource DeepBlue}"/></VerticalStackLayout></Border><Border Grid.Column="2" Style="{StaticResource ActionCard}"><VerticalStackLayout><Label Text="SPENT" Style="{StaticResource Eyebrow}"/><Label Text="{Binding MonthlySpent}" Style="{StaticResource H3}" TextColor="{StaticResource Danger}"/></VerticalStackLayout></Border></Grid>
   <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Envelope balances" Style="{StaticResource H2}"/><Label Text="Tap to change target • use Move Money to reallocate" Style="{StaticResource Muted}"/></VerticalStackLayout><Button Grid.Column="1" Text="Move" Command="{Binding OpenBudgetMoveCommand}" Style="{StaticResource TextButton}"/></Grid>
  </VerticalStackLayout>
  <CollectionView Grid.Row="1" ItemsSource="{Binding Categories}" Margin="0,12,0,0">
   <CollectionView.ItemTemplate><DataTemplate x:DataType="vm:CategoryItem"><Border Style="{StaticResource InteractiveListCard}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference BudgetPageView},Path=BindingContext.EditCategoryCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers><Grid ColumnDefinitions="48,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="11"><Border Style="{StaticResource IconTile}" BackgroundColor="{Binding Color}"><Label Text="{Binding Icon}" TextColor="White" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="{Binding Name}" Style="{StaticResource ItemTitle}"/><Label Text="{Binding Assigned}" Style="{StaticResource Muted}"/><Label Text="{Binding Rollover}" TextColor="{StaticResource DeepBlue}" FontSize="10"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2" VerticalOptions="Center"><Label Text="{Binding Remaining}" TextColor="{Binding StateColor}" FontAttributes="Bold" HorizontalTextAlignment="End"/><Label Text="{Binding Spent}" Style="{StaticResource Muted}" HorizontalTextAlignment="End"/><Label Text="{Binding Target}" TextColor="{StaticResource MutedInk}" FontSize="10" HorizontalTextAlignment="End"/></VerticalStackLayout><ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Progress="{Binding Progress}" ProgressColor="{Binding Color}" Margin="0,7,0,0"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate>
  </CollectionView>
 </Grid><controls:PremiumTabBar Grid.Row="1" ActiveTab="Budget"/></Grid>
</ContentPage>
