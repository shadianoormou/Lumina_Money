<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="LuminaMoney.App.Pages.BudgetAssignPage" Title="Assign money"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:LuminaMoney.App.ViewModels" x:DataType="vm:AppViewModel" Shell.NavBarIsVisible="True" Shell.TabBarIsVisible="False" Shell.BackgroundColor="#080C14" Shell.ForegroundColor="#EAF1FB" Shell.TitleColor="#EAF1FB">
 <ScrollView><VerticalStackLayout x:Name="MotionRoot" Padding="20,14,20,32" Spacing="18">
  <VerticalStackLayout><Label Text="ZERO-BASED ASSIGNMENT" Style="{StaticResource Eyebrow}"/><Label Text="Give available money a job" Style="{StaticResource H1}"/><Label Text="Assignment reserves money for an envelope; spending is recorded separately." Style="{StaticResource Body}"/></VerticalStackLayout>
  <Border Style="{StaticResource HeroCard}"><VerticalStackLayout Spacing="7"><Label Text="READY TO ASSIGN" Style="{StaticResource HeroEyebrow}"/><Label Text="{Binding AssignAvailableText}" TextColor="White" FontSize="27" FontAttributes="Bold"/><Label Text="Only recorded income for the selected month is assignable." TextColor="#C6DAFA" FontSize="12"/></VerticalStackLayout></Border>
  <Border Style="{StaticResource SurfaceCard}"><VerticalStackLayout Spacing="16"><VerticalStackLayout Spacing="6"><Label Text="DESTINATION ENVELOPE" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Picker ItemsSource="{Binding BudgetCategories}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding AssignToCategory}"/></Border></VerticalStackLayout><VerticalStackLayout Spacing="6"><Label Text="AMOUNT TO ASSIGN" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Grid ColumnDefinitions="Auto,*"><Label Text="£" TextColor="{StaticResource DeepGreen}" FontSize="28" FontAttributes="Bold" VerticalOptions="Center"/><Entry Grid.Column="1" Text="{Binding AssignAmountText}" Placeholder="0.00" Keyboard="Numeric" FontSize="28"/></Grid></Border></VerticalStackLayout><Label Text="{Binding FormError}" TextColor="{StaticResource Danger}" FontSize="12"/><Button Text="Assign money" Command="{Binding SaveBudgetAssignCommand}" Style="{StaticResource GreenButton}"/></VerticalStackLayout></Border>
 </VerticalStackLayout></ScrollView>
</ContentPage>
