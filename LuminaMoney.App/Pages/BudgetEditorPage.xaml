<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="LuminaMoney.App.Pages.BudgetEditorPage" Title="Budget target"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:LuminaMoney.App.ViewModels" x:DataType="vm:AppViewModel" Shell.NavBarIsVisible="True" Shell.TabBarIsVisible="False" Shell.BackgroundColor="#080C14" Shell.ForegroundColor="#EAF1FB" Shell.TitleColor="#EAF1FB">
 <ScrollView><VerticalStackLayout x:Name="MotionRoot" Padding="20,14,20,32" Spacing="18">
  <VerticalStackLayout><Label Text="ENVELOPE SETTINGS" Style="{StaticResource Eyebrow}"/><Label Text="Give every pound a job" Style="{StaticResource H1}"/><Label Text="Set the monthly amount you want available for this category." Style="{StaticResource Body}"/></VerticalStackLayout>
  <Border Style="{StaticResource HeroCard}"><VerticalStackLayout Spacing="8"><Label Text="MONTHLY TARGET" Style="{StaticResource HeroEyebrow}"/><Label Text="Plan deliberately, spend confidently." TextColor="White" FontSize="23" FontAttributes="Bold"/><Label Text="Your progress updates instantly with every transaction." TextColor="#C6DAFA" FontSize="12"/></VerticalStackLayout></Border>
  <Border Style="{StaticResource SurfaceCard}"><VerticalStackLayout Spacing="16">
   <VerticalStackLayout Spacing="6"><Label Text="CATEGORY NAME" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Entry Text="{Binding CategoryName}" Placeholder="e.g. Groceries"/></Border></VerticalStackLayout>
   <VerticalStackLayout Spacing="6"><Label Text="TARGET EACH MONTH" Style="{StaticResource Eyebrow}"/><Border Style="{StaticResource InputCard}"><Grid ColumnDefinitions="Auto,*"><Label Text="£" VerticalOptions="Center" TextColor="{StaticResource DeepGreen}" FontAttributes="Bold"/><Entry Grid.Column="1" Text="{Binding BudgetTargetText}" Placeholder="0.00" Keyboard="Numeric"/></Grid></Border></VerticalStackLayout>
   <Label Text="{Binding FormError}" TextColor="{StaticResource Danger}" FontSize="12"/><Button Text="Save budget target" Command="{Binding SaveCategoryCommand}" Style="{StaticResource GreenButton}"/><Button Text="Delete category" Command="{Binding DeleteCategoryCommand}" IsVisible="{Binding IsEditingCategory}" Style="{StaticResource DangerButton}"/>
  </VerticalStackLayout></Border>
 </VerticalStackLayout></ScrollView>
</ContentPage>
