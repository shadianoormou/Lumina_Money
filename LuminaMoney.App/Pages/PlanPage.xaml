<?xml version="1.0" encoding="utf-8"?>
<ContentPage x:Class="LuminaMoney.App.Pages.PlanPage" x:Name="PlanPageView"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:LuminaMoney.App.Controls"
 xmlns:vm="clr-namespace:LuminaMoney.App.ViewModels" x:DataType="vm:AppViewModel" BackgroundColor="{StaticResource PageBackground}" Shell.TabBarIsVisible="False">
 <Grid RowDefinitions="*,Auto" Shell.TabBarIsVisible="False"><ScrollView Grid.Row="0"><VerticalStackLayout x:Name="MotionRoot" Padding="20,14,20,34" Spacing="17">
  <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="FORECAST &amp; GOALS" Style="{StaticResource Eyebrow}"/><Label Text="Plan ahead" Style="{StaticResource H1}"/><Label Text="Live projections, funded goals and recurring commitments" Style="{StaticResource Muted}"/></VerticalStackLayout><Button Grid.Column="1" Text="＋" Command="{Binding AddGoalCommand}" Style="{StaticResource GreenButton}" WidthRequest="54" VerticalOptions="Center"/></Grid>
  <Border IsVisible="{Binding HasStatusMessage}" BackgroundColor="{StaticResource SoftGreen}" StrokeThickness="0" StrokeShape="RoundRectangle 13" Padding="12,9"><Label Text="{Binding StatusMessage}" TextColor="{StaticResource DeepGreen}" FontSize="12"/></Border>
  <Border BackgroundColor="#14243A" Stroke="#293952" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="17" controls:PremiumMotion.IsEnabled="True"><Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10"><Label Text="90-DAY CASH FORECAST" FontSize="10" CharacterSpacing="1.2" TextColor="#9AB0CC" FontAttributes="Bold"/><Border Grid.Column="1" BackgroundColor="#1A2A43" StrokeThickness="0" StrokeShape="RoundRectangle 50" Padding="10,5"><Label Text="{Binding ForecastBadge}" TextColor="{Binding ForecastBadgeColor}" FontSize="9" FontAttributes="Bold"/></Border><Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ForecastHeadline}" TextColor="#EAF1FB" FontSize="20" FontFamily="OpenSansSemibold" FontAttributes="Bold"/><Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*" ColumnSpacing="8"><VerticalStackLayout Spacing="4"><Label Text="INCOME" FontSize="9" CharacterSpacing=".7" TextColor="#8B9BB2" FontAttributes="Bold"/><controls:AnimatedAmountLabel AmountText="{Binding ForecastIncome}" FontFamily="OpenSansSemibold" FontSize="15" FontAttributes="Bold" TextColor="#79B5FF"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="COMMITTED" FontSize="9" CharacterSpacing=".7" TextColor="#8B9BB2" FontAttributes="Bold"/><controls:AnimatedAmountLabel AmountText="{Binding ForecastOutflow}" FontFamily="OpenSansSemibold" FontSize="15" FontAttributes="Bold" TextColor="#8BB8FF"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2" Spacing="4"><Label Text="PROJECTED" FontSize="9" CharacterSpacing=".7" TextColor="#8B9BB2" FontAttributes="Bold"/><controls:AnimatedAmountLabel AmountText="{Binding ForecastBalance}" FontFamily="OpenSansSemibold" FontSize="15" FontAttributes="Bold" TextColor="#EAF1FB"/></VerticalStackLayout></Grid></Grid></Border>
  <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Savings goals" Style="{StaticResource H2}"/><Label Text="Fund a goal without editing its setup" Style="{StaticResource Muted}"/></VerticalStackLayout><Button Grid.Column="1" Text="Reports  →" Command="{Binding OpenReportsCommand}" Style="{StaticResource TextButton}"/></Grid>
  <CollectionView ItemsSource="{Binding Goals}" HeightRequest="{Binding GoalsListHeight}" ItemSizingStrategy="MeasureAllItems">
   <CollectionView.EmptyView><Border Style="{StaticResource SurfaceCard}" HeightRequest="210"><VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="7"><Label Text="◇" FontSize="34" TextColor="{StaticResource PrimaryGreen}" HorizontalOptions="Center"/><Label Text="Create a meaningful goal" Style="{StaticResource H3}"/><Label Text="Set an amount and target date." Style="{StaticResource Muted}"/><Button Text="Add goal" Command="{Binding Source={x:Reference PlanPageView},Path=BindingContext.AddGoalCommand}" Style="{StaticResource TextButton}"/></VerticalStackLayout></Border></CollectionView.EmptyView>
   <CollectionView.ItemTemplate><DataTemplate x:DataType="vm:GoalItem"><Border Style="{StaticResource InteractiveListCard}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference PlanPageView},Path=BindingContext.EditGoalCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers><Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="11"><Border Style="{StaticResource IconTile}" BackgroundColor="{Binding Color}"><Label Text="{Binding Icon}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" Spacing="6"><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding Name}" Style="{StaticResource ItemTitle}"/><Label Grid.Column="1" Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontSize="9" FontAttributes="Bold"/></Grid><ProgressBar Progress="{Binding Progress}" ProgressColor="{Binding Color}"/><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding ProgressText}" FontAttributes="Bold"/><Label Grid.Column="1" Text="{Binding TargetText}" Style="{StaticResource Muted}"/></Grid><Label Text="{Binding MonthlyText}" TextColor="{StaticResource DeepGreen}" FontSize="10"/></VerticalStackLayout><Button Grid.Column="2" Text="Fund" Command="{Binding Source={x:Reference PlanPageView},Path=BindingContext.OpenFundGoalCommand}" CommandParameter="{Binding .}" Style="{StaticResource TextButton}" VerticalOptions="Center"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate>
  </CollectionView>
  <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Bills &amp; subscriptions" Style="{StaticResource H2}"/><Label Text="Swipe right to pay • swipe left to skip" Style="{StaticResource Muted}"/></VerticalStackLayout><Button Grid.Column="1" Text="Add" Command="{Binding AddBillCommand}" Style="{StaticResource TextButton}"/></Grid>
  <CollectionView ItemsSource="{Binding Bills}" HeightRequest="{Binding BillsListHeight}" ItemSizingStrategy="MeasureAllItems">
   <CollectionView.EmptyView><Border Style="{StaticResource SurfaceCard}" HeightRequest="210"><VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="7"><Label Text="↻" FontSize="34" TextColor="{StaticResource PrimaryBlue}" HorizontalOptions="Center"/><Label Text="Track the next commitment" Style="{StaticResource H3}"/><Label Text="Forecasts become more accurate." Style="{StaticResource Muted}"/><Button Text="Add commitment" Command="{Binding Source={x:Reference PlanPageView},Path=BindingContext.AddBillCommand}" Style="{StaticResource TextButton}"/></VerticalStackLayout></Border></CollectionView.EmptyView>
   <CollectionView.ItemTemplate><DataTemplate x:DataType="vm:BillItem"><SwipeView><SwipeView.LeftItems><SwipeItems Mode="Execute"><SwipeItem Text="Paid" BackgroundColor="{StaticResource PrimaryGreen}" Command="{Binding Source={x:Reference PlanPageView},Path=BindingContext.MarkBillPaidCommand}" CommandParameter="{Binding .}"/></SwipeItems></SwipeView.LeftItems><SwipeView.RightItems><SwipeItems Mode="Execute"><SwipeItem Text="Skip" BackgroundColor="{StaticResource PrimaryBlue}" Command="{Binding Source={x:Reference PlanPageView},Path=BindingContext.SkipBillCommand}" CommandParameter="{Binding .}"/></SwipeItems></SwipeView.RightItems><Border Style="{StaticResource InteractiveListCard}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference PlanPageView},Path=BindingContext.EditBillCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers><Grid ColumnDefinitions="5,*,Auto" ColumnSpacing="11"><BoxView Color="{Binding Color}" CornerRadius="3"/><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Badge}" TextColor="{Binding Color}" FontSize="9" CharacterSpacing="1.1" FontAttributes="Bold"/><Label Text="{Binding Name}" Style="{StaticResource ItemTitle}"/><Label Text="{Binding DueText}" Style="{StaticResource Muted}"/><Label Text="{Binding DueState}" TextColor="{Binding DueStateColor}" FontSize="9" FontAttributes="Bold"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2" VerticalOptions="Center"><Label Text="{Binding AmountText}" Style="{StaticResource H3}" HorizontalTextAlignment="End"/><Label Text="Edit  →" Style="{StaticResource Muted}" HorizontalTextAlignment="End"/></VerticalStackLayout></Grid></Border></SwipeView></DataTemplate></CollectionView.ItemTemplate>
  </CollectionView>
 </VerticalStackLayout></ScrollView><controls:PremiumTabBar Grid.Row="1" ActiveTab="Plan"/></Grid>
</ContentPage>
